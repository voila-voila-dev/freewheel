{
	"name": "@freewheel/server",
	"description": "Own server: telemetry ingest, outage scenes, bets, replays, dashboard API",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "bun build --compile --target=bun-linux-x64 --outfile dist/freewheel-server src/index.ts",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"dev": "bun --watch src/index.ts"
	},
	"dependencies": {
		"@effect/platform-bun": "catalog:effect",
		"@freewheel/domain": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@freewheel/typescript-config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
