---
import { getCollection, render } from "astro:content";
import DocsLayout from "@voila.dev/site/components/DocsLayout.astro";
import Logo from "../../components/Logo.astro";
import { repo } from "../../data/bench";
import { docsNav } from "../../data/docs";
import { footer, links, siteName } from "../../data/site";

export async function getStaticPaths() {
	return (await getCollection("docs")).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	siteName={siteName}
	nav={docsNav}
	headings={headings}
	top={{ name: siteName, links, repo }}
	footer={footer}
	edit={`${repo}/edit/main/${entry.data.source}`}
>
	<Logo slot="logo" />
	<Content />
</DocsLayout>
